#!/usr/bin/env node

const fs = require('fs');
const os = require('os');
const path = require('path');
const { execFileSync } = require('child_process');

const HOME = os.homedir();
const CODEX_HOME = process.env.CODEX_HOME || path.join(HOME, '.codex');
const SESSION_DIR = path.join(CODEX_HOME, 'sessions');
const STATE_DB = path.join(CODEX_HOME, 'state_5.sqlite');
const args = new Set(process.argv.slice(2));
const verbose = args.has('--verbose');
const noColor = args.has('--no-color');

function walkJsonl(dir, out = []) {
  let entries;
  try {
    entries = fs.readdirSync(dir, { withFileTypes: true });
  } catch {
    return out;
  }
  for (const entry of entries) {
    const p = path.join(dir, entry.name);
    if (entry.isDirectory()) walkJsonl(p, out);
    else if (entry.isFile() && entry.name.endsWith('.jsonl')) out.push(p);
  }
  return out;
}

function latestSessionFile() {
  const files = walkJsonl(SESSION_DIR);
  let best = null;
  for (const file of files) {
    let st;
    try {
      st = fs.statSync(file);
    } catch {
      continue;
    }
    if (!best || st.mtimeMs > best.mtimeMs) best = { file, mtimeMs: st.mtimeMs };
  }
  return best?.file || null;
}

function parseLatestTelemetry(file) {
  const result = {
    sessionId: null,
    model: null,
    cwd: null,
    token: null,
    rate: null,
    timestamp: null,
  };
  const text = fs.readFileSync(file, 'utf8');
  for (const line of text.split('\n')) {
    if (!line.trim()) continue;
    let row;
    try {
      row = JSON.parse(line);
    } catch {
      continue;
    }
    if (row.type === 'session_meta') {
      result.sessionId = row.payload?.id || result.sessionId;
      result.cwd = row.payload?.cwd || result.cwd;
    }
    if (row.type === 'turn_context') {
      result.model = row.payload?.model || result.model;
      result.cwd = row.payload?.cwd || result.cwd;
    }
    if (row.type === 'event_msg' && row.payload?.type === 'token_count') {
      result.token = row.payload.info || result.token;
      result.rate = row.payload.rate_limits || result.rate;
      result.timestamp = row.timestamp || result.timestamp;
    }
  }
  return result;
}

function sqliteModelForSession(sessionId) {
  if (!sessionId || !fs.existsSync(STATE_DB)) return null;
  try {
    return execFileSync('sqlite3', [
      STATE_DB,
      'select model from threads where id = ?1 limit 1;',
      sessionId,
    ], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim() || null;
  } catch {
    try {
      const sql = `select model from threads where id = '${sessionId.replaceAll("'", "''")}' limit 1;`;
      return execFileSync('sqlite3', [STATE_DB, sql], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim() || null;
    } catch {
      return null;
    }
  }
}

function formatModel(id) {
  if (!id) return 'Codex';
  const clean = id.toLowerCase();
  if (clean === 'gpt-5.5') return 'GPT-5.5';
  if (clean === 'gpt-5.4') return 'GPT-5.4';
  if (clean === 'gpt-5.4-mini') return 'GPT-5.4 Mini';
  if (clean === 'gpt-5.3-codex') return 'GPT-5.3 Codex';
  if (clean === 'gpt-5.3-codex-spark') return 'GPT-5.3 Spark';
  if (clean === 'gpt-5.2') return 'GPT-5.2';
  return id.replace(/^gpt-/, 'GPT-').replaceAll('-', ' ');
}

function pct(n) {
  if (typeof n !== 'number' || !Number.isFinite(n)) return null;
  return Math.max(0, Math.min(100, Math.round(n)));
}

function resetTime(unixSeconds) {
  if (!unixSeconds) return null;
  const d = new Date(unixSeconds * 1000);
  const h = d.getHours();
  const m = String(d.getMinutes()).padStart(2, '0');
  return `${h % 12 || 12}:${m}${h < 12 ? 'am' : 'pm'}`;
}

function contextPercent(tokenInfo) {
  const window = tokenInfo?.model_context_window;
  const input = tokenInfo?.last_token_usage?.input_tokens;
  if (!window || !input) return 0;
  return pct((input / window) * 100) ?? 0;
}

function hexToAnsi256(hex) {
  const r = parseInt(hex.slice(1, 3), 16);
  const g = parseInt(hex.slice(3, 5), 16);
  const b = parseInt(hex.slice(5, 7), 16);
  if (r === g && g === b) {
    if (r < 8) return 16;
    if (r > 248) return 231;
    return Math.round(((r - 8) / 247) * 24) + 232;
  }
  return 16 + 36 * Math.round((r / 255) * 5) + 6 * Math.round((g / 255) * 5) + Math.round((b / 255) * 5);
}

const R = '\x1b[0m';
const fg = (hex) => noColor ? '' : `\x1b[38;5;${hexToAnsi256(hex)}m`;
const bg = (hex) => noColor ? '' : `\x1b[48;5;${hexToAnsi256(hex)}m`;
const ARROW = noColor ? ' > ' : '\uE0B0';
const BASE_FG = '#111827';
const MODEL_BG = '#c084fc';
const FIVE_BG = '#38bdf8';
const WEEK_BG = '#4ade80';
const CTX_BG = '#f472b6';
const WARN_BG = '#f59e0b';
const WARN_FG = '#1e1e2e';
const CRIT_BG = '#ef4444';
const CRIT_FG = '#ffffff';

function colorsForPercent(value, normalBg) {
  if (value >= 90) return { bgHex: CRIT_BG, fgHex: CRIT_FG };
  if (value >= 70) return { bgHex: WARN_BG, fgHex: WARN_FG };
  return { bgHex: normalBg, fgHex: BASE_FG };
}

function renderPowerline(segs) {
  if (noColor) return segs.map((s) => s.text.trim()).join(' > ');
  let out = '';
  for (let i = 0; i < segs.length; i++) {
    const s = segs[i];
    const next = segs[i + 1];
    out += bg(s.bgHex) + fg(s.fgHex) + s.text + R;
    out += next ? fg(s.bgHex) + bg(next.bgHex) + ARROW : fg(s.bgHex) + ARROW + R;
  }
  return out;
}

function render(data) {
  const primary = data.rate?.primary;
  const secondary = data.rate?.secondary;
  const fivePct = pct(primary?.used_percent);
  const weekPct = pct(secondary?.used_percent);
  const ctxPct = contextPercent(data.token);
  const compact = (process.stdout.columns || 120) < 80;
  const segs = [];

  segs.push({ bgHex: MODEL_BG, fgHex: BASE_FG, text: ` \u2731 ${formatModel(data.model)} ` });

  const fiveColors = colorsForPercent(fivePct ?? 0, FIVE_BG);
  const fiveReset = !compact ? resetTime(primary?.resets_at) : null;
  const fiveLabel = compact ? '5h' : '5h used';
  segs.push({
    ...fiveColors,
    text: ` \u25EB ${fiveLabel} ${fivePct ?? '--'}%${fiveReset ? ` \u2192 ${fiveReset}` : ''} `,
  });

  const weekColors = colorsForPercent(weekPct ?? 0, WEEK_BG);
  const weekLabel = compact ? 'wk' : 'week used';
  segs.push({ ...weekColors, text: ` \u25CB ${weekLabel} ${weekPct ?? '--'}% ` });

  const ctxColors = colorsForPercent(ctxPct, CTX_BG);
  const ctxLabel = compact ? 'ctx' : 'ctx used';
  segs.push({ ...ctxColors, text: ` \u25D0 ${ctxLabel} ${ctxPct}% ` });

  return renderPowerline(segs);
}

function main() {
  const file = latestSessionFile();
  if (!file) {
    console.log('Codex Meter: no session telemetry found yet');
    process.exit(0);
  }
  const data = parseLatestTelemetry(file);
  data.model = data.model || sqliteModelForSession(data.sessionId);
  console.log(render(data));
  if (verbose) {
    const total = data.token?.total_token_usage?.total_tokens;
    const last = data.token?.last_token_usage?.total_tokens;
    const window = data.token?.model_context_window;
    const plan = data.rate?.plan_type;
    console.log(`session: ${file}`);
    console.log(`plan: ${plan || 'unknown'}`);
    console.log(`tokens: total=${total ?? 'unknown'} last=${last ?? 'unknown'} context_window=${window ?? 'unknown'}`);
  }
}

main();
